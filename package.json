{
  "name": "manim-web",
  "version": "0.3.24",
  "description": "Manim-like mathematical animation library for the web",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "import": "./dist/integrations/react.js",
      "default": "./dist/integrations/react.js"
    },
    "./vue": {
      "types": "./dist/integrations/vue.d.ts",
      "import": "./dist/integrations/vue.js",
      "default": "./dist/integrations/vue.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/manim-web.browser.js",
      "default": "./dist/manim-web.browser.js"
    },
    "./reveal": {
      "source": "./src/reveal/index.ts",
      "types": "./dist/reveal/index.d.ts",
      "import": "./dist/reveal/index.js",
      "default": "./dist/reveal/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/slides.mjs",
    "scripts/slides/runtime.mjs",
    "scripts/slides/shared.mjs",
    "examples/presentations/basic"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.browser.config.ts",
    "build:browser": "vite build --config vite.browser.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:no-disable": "bash scripts/check-no-eslint-disable.sh",
    "format": "prettier --write src/",
    "docs": "npm run build && node scripts/generate-example-docs.mjs && cd docs && npm run build",
    "docs:dev": "npm run build && node scripts/generate-example-docs.mjs && cd docs && npm start",
    "docs:examples": "node scripts/generate-example-docs.mjs",
    "lint:strict": "eslint src/ --max-warnings 106",
    "circular": "madge --circular --extensions ts src/",
    "cpd": "jscpd src/",
    "test:integration": "npx playwright test",
    "format:check": "prettier --check src/",
    "knip": "knip",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "prepare": "husky",
    "typecheck:presentations": "tsc -p tsconfig.presentations.json --noEmit",
    "test:presentations": "playwright test -c playwright.presentations.config.ts",
    "test:authoring": "playwright test -c playwright.authoring.config.ts",
    "test:tech-demo": "node scripts/qualify-tech-demo.mjs && node scripts/test-presentation-cache.mjs",
    "test:shared-runtime": "node --test scripts/slides/runtime-identity.test.mjs && node scripts/test-shared-runtime.mjs",
    "test:clean": "node --test scripts/clean.test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "^4.1.1",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.185.1",
    "earcut": "^3.0.2",
    "gif.js": "^0.2.0",
    "katex": "^0.17.0",
    "marked": "^18.0.13",
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "shiki": "^4.4.3",
    "three": "^0.185.1",
    "typia": "^12.1.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.2",
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.58.2",
    "@types/earcut": "^3.0.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.13",
    "@types/reveal.js": "^5.2.2",
    "@typia/unplugin": "^12.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "jscpd": "^5.0.9",
    "knip": "^6.1.0",
    "lint-staged": "^17.0.4",
    "madge": "^8.0.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.8.1",
    "reveal.js": "^6.0.2",
    "standard-version": "^9.5.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.0.18",
    "vue": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "reveal.js": ">=5.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "reveal.js": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maloyan/manim-js.git"
  },
  "homepage": "https://maloyan.github.io/manim-js/",
  "bugs": {
    "url": "https://github.com/maloyan/manim-js/issues"
  },
  "keywords": [
    "animation",
    "math",
    "visualization",
    "manim",
    "threejs",
    "webgl",
    "3blue1brown",
    "mathematical-animations",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "slides": "scripts/slides.mjs"
  }
}
