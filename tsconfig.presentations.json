{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "rootDir": ".",
    "customConditions": ["source"],
    "paths": {
      "@/*": ["src/*"],
      "manim-web": ["src/index.ts"],
      "manim-web/reveal": ["src/reveal/index.ts"]
    }
  },
  "include": ["src", "examples/presentations"],
  "exclude": ["src/**/*.test.ts"]
}
